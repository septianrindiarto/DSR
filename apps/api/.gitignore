node_modules/
.env
# NOTE: drizzle/ is intentionally TRACKED — it holds the hand-written SQL
# migrations the deploy runs via `npm run migrate`. Do not ignore it, or the
# production clone won't have any migrations to apply.
uploads/*
!uploads/.gitkeep

# Private uploads (agency legal documents incl. KTP) — never commit, never serve statically
uploads-private/

# Backups written by src/scripts/purge-contract.js (contain client data) — never commit
purge-backups/
