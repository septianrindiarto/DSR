# ─────────────────────────────────────────────────────────────────────────────
# Production env for apps/api — copy to /home/dsr/dsr/apps/api/.env on the VPS
#   nano ~/dsr/apps/api/.env   →   chmod 600 ~/dsr/apps/api/.env
# Fill the values on the server only. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database (Neon) ─────────────────────────────────────────────────────────
# Reusing the current dev database: copy DATABASE_URL from your dev .env.
# Prefer the "-pooler" host from the Neon dashboard.
DATABASE_URL=

# ─── Auth / URLs — all exactly the public https origin ───────────────────────
BETTER_AUTH_SECRET=            # openssl rand -hex 32   (new value for prod is fine; everyone re-logs in)
BETTER_AUTH_URL=https://dsrappai.com
CORS_ORIGIN=https://dsrappai.com
APP_URL=https://dsrappai.com

# ─── Encryption (MANDATORY in production — API refuses to start without it) ──
# Reusing the dev database: use the SAME key as dev if dev already has one,
# otherwise SIM numbers / NIB / NPWP / private files encrypted with it can't be
# read. If dev never had a key, generate one now (openssl rand -base64 32),
# put it here AND in your dev .env, and keep a copy in your password manager.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# DATA_ENCRYPTION_OLD_KEYS=     # only after a key rotation

# ─── Email (Gmail) — same values as dev ──────────────────────────────────────
GMAIL_USER=
GMAIL_FROM_NAME=DSR Solution
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_APP_PASSWORD=

# ─── Telegram admin alerts (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_MASK_CONTACT=true

# ─── Business defaults ───────────────────────────────────────────────────────
ADMIN_WHATSAPP=
DEFAULT_AGENCY_ID=             # id of DSR Rent Car (public orders without agency code)

# ─── Online payment (Xendit) — leave empty until you have live keys ──────────
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_AGENCY_IDS=
XENDIT_CASH_ACCOUNT_CODE=1-1200
XENDIT_INVOICE_HOURS=72
# XENDIT_MOCK must NOT be set in production

# ─── Neon reliability ────────────────────────────────────────────────────────
# Neon FREE plan = 100 CU-hours/month. 0.25 CU awake 1 h = 0.25 CU-hour, so keep-warm
# 06–23 every day (~135 CU-h) would use up the month and switch the DB off.
# 8-16 = 08:00–16:59 WIB (~68 CU-h/month) leaves room for other use. Paid plan: widen.
DB_KEEP_WARM=true              # ping every 4 min inside DB_KEEP_WARM_HOURS (WIB, both ends inclusive)
DB_KEEP_WARM_MINUTES=4
DB_KEEP_WARM_HOURS=8-16

# ─── Background jobs / reminders ─────────────────────────────────────────────
# JOBS_DISABLED=true            # only to switch scheduled jobs off
# CLAIM_REMINDERS_DISABLED=true
CLAIM_REMINDER_MINUTES=30
CLAIM_OVERDUE_MINUTES=60

DEBUG=false
REKAP_SYNC_DISABLED=true
