# ~/.dsr-backup.env  (chmod 600) — used by ops/backup/backup.sh
# Neon DIRECT (unpooled) connection string — host WITHOUT "-pooler".
BACKUP_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
BACKUP_DIR="/home/dsr/backups"
APP_DIR="/home/dsr/DSR/apps/api"
# Off-site copy (configure with `rclone config` first), e.g. "gdrive:dsr-backups" or "b2:dsr-backups"
RCLONE_REMOTE=""
# Optional: encrypt backups with a GPG public key (recommended when RCLONE_REMOTE is set)
BACKUP_GPG_RECIPIENT=""
# Optional: ping URL after success (Healthchecks.io / Better Stack heartbeat)
BACKUP_HEARTBEAT_URL=""
